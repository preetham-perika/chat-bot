    {
      "name": "5. WhatsApp Webhooks",
      "item": [
        {
          "name": "Meta Webhook Verification (GET Handshake)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/webhook?hub.mode=subscribe&hub.verify_token={{verifyToken}}&hub.challenge=test_meta_challenge_12345",
              "host": ["{{baseUrl}}"],
              "path": ["webhook"],
              "query": [
                {
                  "key": "hub.mode",
                  "value": "subscribe"
                },
                {
                  "key": "hub.verify_token",
                  "value": "{{verifyToken}}"
                },
                {
                  "key": "hub.challenge",
                  "value": "test_meta_challenge_12345"
                }
              ]
            },
            "description": "Meta WhatsApp Cloud API setup challenge verification. Returns the challenge token with 200 OK."
          }
        },
        {
          "name": "Meta Inbound Message (POST Webhook)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [\n    {\n      \"id\": \"1234567890\",\n      \"changes\": [\n        {\n          \"value\": {\n            \"messaging_product\": \"whatsapp\",\n            \"metadata\": {\n              \"display_phone_number\": \"15550234567\",\n              \"phone_number_id\": \"100000000000001\"\n            },\n            \"contacts\": [\n              {\n                \"profile\": {\n                  \"name\": \"Dad\"\n                },\n                \"wa_id\": \"919876543211\"\n              }\n            ],\n            \"messages\": [\n              {\n                \"from\": \"919876543211\",\n                \"id\": \"wamid.test.001\",\n                \"timestamp\": \"1710000000\",\n                \"text\": {\n                  \"body\": \"hii\"\n                },\n                \"type\": \"text\"\n              }\n            ]\n          },\n          \"field\": \"messages\"\n        }\n      ]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["webhook"]
            },
            "description": "Simulates an incoming WhatsApp message payload from Meta Cloud API."
          }
        },
        {
          "name": "Twilio Inbound Message (POST Webhook)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "From",
                  "value": "whatsapp:+919876543211",
                  "type": "text"
                },
                {
                  "key": "Body",
                  "value": "hii",
                  "type": "text"
                },
                {
                  "key": "ProfileName",
                  "value": "Dad",
                  "type": "text"
                },
                {
                  "key": "MessageSid",
                  "value": "SM1234567890abcdef",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/webhook/twilio",
              "host": ["{{baseUrl}}"],
              "path": ["webhook", "twilio"]
            },
            "description": "Simulates an incoming WhatsApp message from Twilio."
          }
        }
      ]
